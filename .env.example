# =============================================================================
# TurfFlow Production Environment Variables
# Synchronized for Website (React/Vite) & WhatsApp Automation (AI Agent/n8n)
# =============================================================================

# Server & Node Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# 1. Supabase PostgreSQL Database & Realtime Sync
# Get from https://supabase.com/dashboard -> Project Settings -> API & Database
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres.your-ref:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Frontend Vite Variables (Available in Browser React Portal)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 2. Redis Connection (Optional for Distributed Slot Locks & Queue)
REDIS_URL=redis://default:your_redis_password@redis-1234.upstash.io:6379

# 3. Razorpay Payment Gateway (India)
# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_phrase

# 4. WhatsApp Business Cloud API / Interakt
# Get from Meta Developer Portal or Interakt settings
WHATSAPP_API_URL=https://api.interakt.ai/v1/public/message/
WHATSAPP_API_KEY=your_interakt_api_key

# 5. SMS Fallback API (MSG91 / Twilio)
SMS_API_KEY=your_msg91_auth_key
SMS_SENDER_ID=TRFFLW

# 6. Admin Authentication Secret
JWT_SECRET=super_secret_jwt_key_minimum_32_characters

# 7. Resend Email Delivery API (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
VITE_RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
